# Cấu hình Secrets cho VietinBank Vietnamese ASR Recording App
# Khi triển khai trên Streamlit Community Cloud: Sao chép các trường bên dưới vào mục App Settings -> Secrets.
# Khi chạy cục bộ: Sao chép tệp này thành .streamlit/secrets.toml và điền giá trị thật (KHÔNG commit secrets.toml lên Git).

# Tên namespace Hugging Face (username hoặc organization sở hữu Storage Bucket)
HF_NAMESPACE = "your-hf-username-or-org"

# Tên Storage Bucket riêng tư trên Hugging Face (mặc định theo đặc tả: vtb-recording-data)
HF_BUCKET_NAME = "vtb-recording-data"

# S3 Access Key ID được tạo từ Hugging Face UI (Settings -> Access Tokens -> S3 Credentials)
HF_S3_ACCESS_KEY_ID = "your-generated-s3-access-key-id"

# S3 Secret Access Key được tạo tương ứng từ Hugging Face UI
HF_S3_SECRET_ACCESS_KEY = "your-generated-s3-secret-access-key"

# Mật khẩu quản trị cho trang /admin (người dùng gợi ý "ilovevtb", khuyến nghị đổi mật khẩu mạnh hơn khi public)
ADMIN_PASSWORD = "ilovevtb"

# Đặt true để chạy thử nghiệm cục bộ với MockStorage (không cần tài khoản HF S3).
# Khi triển khai thực tế trên Cloud, đặt false hoặc xóa dòng này.
MOCK_STORAGE = false

